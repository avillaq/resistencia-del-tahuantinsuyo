.hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    justify-content: space-between;
    padding: 24px;
    pointer-events: none;
}

.hud-top-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hud-panel {
    background-color: rgba(36, 26, 18, 0.92);
    border-color: #9A5B3E;
    border-width: 2px;
    border-radius: 8px;
    padding: 12px 18px;
    flex-direction: row;
    align-items: center;
}

.health-section {
    flex-direction: column;
    margin-right: 16px;
}

.health-label-header {
    color: #E7DCC8;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 3px;
    letter-spacing: 1px;
}

.health-bar-container {
    width: 220px;
    height: 26px;
    background-color: rgba(24, 14, 10, 0.95);
    border-color: #6B4F3A;
    border-width: 2px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    justify-content: center;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: #A94136;
    position: absolute;
    left: 0;
    top: 0;
}

.health-bar-text {
    color: #E7DCC8;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    position: relative;
    letter-spacing: 1px;
}

.badge {
    padding: 6px 14px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.badge-stealth {
    background-color: #43526D;
    color: #E7DCC8;
    border-color: #C9A66B;
    border-width: 1.5px;
}

.badge-alert {
    background-color: #A94136;
    color: #FFFFFF;
    border-color: #E7DCC8;
    border-width: 1.5px;
}

.score-text {
    color: #C9A66B;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.relics-text {
    color: #E7DCC8;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* Modales de Fin de Misión / Derrota */
.modal-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background-color: rgba(18, 14, 12, 0.90);
    justify-content: center;
    align-items: center;
    pointer-events: auto;
}

.modal-box {
    width: 480px;
    background-color: rgba(44, 32, 24, 0.98);
    border-color: #C9A66B;
    border-width: 3px;
    border-radius: 10px;
    padding: 28px;
    align-items: center;
}

.modal-title {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 14px;
    letter-spacing: 1.5px;
}

.modal-title-victory {
    color: #C9A66B;
}

.modal-title-defeat {
    color: #A94136;
}

.modal-message {
    color: #E7DCC8;
    font-size: 15px;
    text-align: center;
    margin-bottom: 20px;
    white-space: normal;
    line-height: 20px;
}

.modal-score {
    color: #C9A66B;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 24px;
    letter-spacing: 1px;
}

.modal-button {
    width: 190px;
    height: 46px;
    background-color: #6B4F3A;
    color: #E7DCC8;
    border-color: #C9A66B;
    border-width: 2px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
    cursor: link;
}

.modal-button:hover {
    background-color: #9A5B3E;
    color: #FFFFFF;
    border-color: #E7DCC8;
}